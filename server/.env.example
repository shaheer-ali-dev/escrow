ENABLE_INDEXER=false
INDEXER_INTERVAL_MS=30000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
